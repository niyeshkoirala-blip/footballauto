# Make.com webhooks
MAKE_WEBHOOK_URL=
MAKE_REEL_WEBHOOK_URL=

# Required image fallback key
PEXELS_API_KEY=

# Optional AI captions and Reel mood classification
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Branding and publishing limits
PAGE_NAME=FOOTBALL NEWS
BREAKING_THRESHOLD=50
MAX_AGE_MINUTES=30
MIN_POSTS_PER_DAY=10
MAX_POSTS_PER_DAY=60
POST_DELAY_MIN=25
POST_DELAY_MAX=35

# Match cards
FIXTURE_WINDOW_HOURS=2
RESULT_WINDOW_HOURS=3

# Daemon
POLL_SECONDS=60
MAX_RUNTIME_MIN=290

# Optional Graph API Reel path; not used when publishing through Make
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
GRAPH_API_VERSION=v23.0
