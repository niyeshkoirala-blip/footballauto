# ─── POSTING METHOD (choose one) ─────────────────────────────────────────────

# RECOMMENDED: Make.com webhook (no browser, works on GitHub Actions)
# Step 1: sign up free at https://make.com
# Step 2: create scenario → Custom Webhook → Facebook → Create Page Post
#         connect your Facebook page in that scenario
# Step 3: paste the webhook URL below
# Multiple accounts: paste several URLs comma-separated to spread load and
# multiply the free-tier quota (5 accounts ≈ 5x). Load is split randomly.
#   MAKE_WEBHOOK_URL=https://hook.../a,https://hook.../b,https://hook.../c
MAKE_WEBHOOK_URL=
MAKE_REEL_WEBHOOK_URL=

# FALLBACK: browser automation (only used if MAKE_WEBHOOK_URL is blank)
FB_EMAIL=your_facebook_email@gmail.com
FB_PASSWORD=your_facebook_password
FB_PAGE_URL=https://www.facebook.com/YourPageName
# Set FB_HEADLESS=1 after first login to run without a visible browser window
FB_HEADLESS=

# ─── REQUIRED ─────────────────────────────────────────────────────────────────
# Pexels free image API (sign up free at https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_api_key

# ─── OPTIONAL ─────────────────────────────────────────────────────────────────
# Groq free AI API for smarter captions (sign up free at https://console.groq.com)
GROQ_API_KEY=

# ─── SETTINGS ─────────────────────────────────────────────────────────────────
PAGE_NAME=FOOTBALL NEWS
MAX_POSTS_PER_DAY=15
MIN_POSTS_PER_DAY=10
BREAKING_THRESHOLD=50
# Lowest the threshold may drop to when behind MIN_POSTS_PER_DAY, as a % of
# BREAKING_THRESHOLD. 100 = never relax, 0 = old behaviour (post anything).
RELAX_FLOOR_PCT=80
POST_DELAY_MIN=25
POST_DELAY_MAX=35

# ─── REELS (Facebook Graph API — free, no Make.com operations) ────────────────
# Run `python get_token.py` to fill these in. Leave them blank and reels stay
# off; everything still posts as photos through Make as before.
# Reels out-reach photo posts, so the best stories of the day go out as video
# instead of an image — never both, duplicate content helps nobody.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
REELS_PER_DAY=2
REEL_MIN_SCORE=90

# ─── MATCH CARDS (ESPN public API — no key needed) ────────────────────────────
# Fixtures and full-time results for the top 5 leagues + Champions League,
# posted on a time window rather than a keyword score. Widen these to cover
# more of a matchday; narrow them if match cards crowd out the news.
FIXTURE_WINDOW_HOURS=2
RESULT_WINDOW_HOURS=3

# ─── DAEMON MODE (python main.py --daemon) ───────────────────────────────────
# Continuous listening: poll feeds every POLL_SECONDS, post fresh worthy news
# immediately, spacing posts by POST_DELAY_MIN..MAX seconds,
# exit after MAX_RUNTIME_MIN so the next scheduled job takes over.
POLL_SECONDS=60
MAX_RUNTIME_MIN=290
